const color=(a,b,u,o)=>o.set(a).lerp(new THREE.Color(b),u);function sample(t){let i=0;while(i<K.length-2&&t>K[i+1].t)i++;let a=K[i],b=K[i+1],u=THREE.MathUtils.smoothstep((t-a.t)/(b.t-a.t),0,1);return{a,b,u}}function setTime(t){let{a,b,u}=sample(t),m=k=>THREE.MathUtils.lerp(a[k],b[k],u),c=new THREE.Color();color(a.top,b.top,u,U.top.value);color(a.hor,b.hor,u,U.hor.value);color(a.bot,b.bot,u,U.bot.value);color(a.sun,b.sun,u,U.sun.value);let el=THREE.MathUtils.degToRad(m('el')),az=THREE.MathUtils.degToRad(m('az'));U.sunDir.value.set(Math.cos(el)*Math.cos(az),Math.sin(el),Math.cos(el)*Math.sin(az));U.sunI.value=m('si');U.cloud.value=m('cl');U.storm.value=m('st');key.position.copy(U.sunDir.value).multiplyScalar(30);key.color.copy(U.sun.value);key.intensity=m('si');hemi.color.copy(U.top.value);color(a.bot,b.bot,u,hemi.groundColor);hemi.intensity=THREE.MathUtils.lerp(1.08,.34,m('st'));color(a.fog,b.fog,u,c);scene.fog.color.copy(c);scene.fog.density=m('fd');renderer.setClearColor(c);renderer.toneMappingExposure=m('ex');ground.material.color.copy(U.bot.value);state.textContent=`Atmosphere director — ${u<.5?a.n:b.n}`}
const slider=document.querySelector('#time'),value=document.querySelector('#value'),keys=document.querySelector('#keys'),state=document.querySelector('#state');K.forEach(k=>{let b=document.createElement('button');b.textContent=k.n;b.onclick=()=>{slider.value=k.t;slider.dispatchEvent(new Event('input'))};keys.append(b)});slider.oninput=()=>{value.value=(+slider.value).toFixed(3);setTime(+slider.value);[...keys.children].forEach((b,i)=>b.classList.toggle('active',Math.abs(K[i].t-slider.value)<.002))};function resize(){renderer.setPixelRatio(Math.min(devicePixelRatio||1,innerWidth<821?1.25:1.75));renderer.setSize(innerWidth,innerHeight,false);camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix()}addEventListener('resize',resize);resize();setTime(0);
const perf=document.querySelector('#perf');let frames=0,start=performance.now(),last=start,sum=0,worst=0;function tick(now){requestAnimationFrame(tick);let dt=now-last;last=now;frames++;sum+=dt;worst=Math.max(worst,dt);U.clock.value=now*.001;renderer.render(scene,camera);if(now-start>1000){let fps=frames*1000/(now-start),calls=renderer.info.render.calls,tris=renderer.info.render.triangles;perf.textContent=`${fps.toFixed(1)} fps · ${(sum/frames).toFixed(2)} ms avg\n${worst.toFixed(2)} ms worst · ${calls} calls · ${tris.toLocaleString()} tris`;window.__ATMOSPHERE_METRICS__={fps,calls,triangles:tris};frames=0;sum=worst=0;start=now}}requestAnimationFrame(tick);
