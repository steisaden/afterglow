scene.add(new THREE.Mesh(new THREE.SphereGeometry(160,32,18),new THREE.ShaderMaterial({side:THREE.BackSide,depthWrite:false,fog:false,uniforms:U,vertexShader:`varying vec3 d;void main(){d=normalize(position);gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.);}`,fragmentShader:`varying vec3 d;uniform vec3 top,hor,bot,sun,sunDir;uniform float sunI,cloud,storm,clock;float h(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}float n(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(h(i),h(i+vec2(1,0)),f.x),mix(h(i+vec2(0,1)),h(i+1.),f.x),f.y);}float f(vec2 p){float v=.55*n(p);p=p*2.03+13.7;v+=.28*n(p);p=p*2.01+7.1;return v+.14*n(p);}void main(){vec3 q=normalize(d),c=q.y<0.?mix(bot,hor,smoothstep(-.18,.04,q.y)):mix(hor,top,pow(clamp(q.y,0.,1.),.42));float s=max(dot(q,normalize(sunDir)),0.),disc=smoothstep(.99972,.9999,s),glow=pow(s,96.)*.55+pow(s,12.)*.09;float shape=f(vec2(atan(q.z,q.x)*1.8+clock*.012,q.y*5.2)),band=smoothstep(-.02,.18,q.y)*(1.-smoothstep(.55,.84,q.y)),cov=smoothstep(1.-cloud*.6,1.,shape)*band;vec3 lit=mix(vec3(.76,.78,.78),sun,.34),dark=mix(vec3(.24,.27,.28),vec3(.43,.45,.44),shape);c=mix(c,mix(lit,dark,storm),cov*(.58+.38*storm));c+=sun*(glow*sunI+disc*sunI*1.9)*(1.-cov*.72);gl_FragColor=vec4(c,1.);}`})));
