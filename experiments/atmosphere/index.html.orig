<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Afterglow Atmosphere</title><style>*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#172130;color:#fff;font:13px system-ui}canvas{width:100%;height:100%;display:block}.ui,#perf{position:fixed;background:#111d;border:1px solid #fff3;padding:12px;z-index:2}.ui{left:16px;bottom:16px;width:min(600px,calc(100% - 32px))}#perf{right:16px;top:16px;white-space:pre;text-align:right;font-family:monospace}.row{display:flex;gap:10px;align-items:center}input{width:100%}.keys{display:flex;gap:5px;flex-wrap:wrap;margin-top:9px}button{background:#29313a;color:#fff;border:1px solid #998b7b;padding:5px 8px}button.active{background:#d49c58;color:#111}</style></head><body><canvas id="scene"></canvas><div id="perf">warming up…</div><div class="ui"><div id="state">Atmosphere director</div><div class="row"><label>timeOfDay</label><input id="time" type="range" min="0" max="1" step=".001" value="0"><output id="value">0.000</output></div><div class="keys" id="keys"></div></div><script type="module" src="./atmosphere.js"></script></body></html>
